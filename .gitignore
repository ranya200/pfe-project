# ══════════════════════════════════════════════════════════

# Dépendances
frontend/node_modules/
node_modules/

# Build de production
frontend/dist/
frontend/build/

# Cache Vite
frontend/.vite/
frontend/node_modules/.vite/

# Variables d'environnement frontend
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Logs npm/yarn
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

