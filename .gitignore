# ══════════════════════════════════════════════════════════
# PYTHON / DJANGO — Backend
# ══════════════════════════════════════════════════════════

# Environnement virtuel
backend/venv/
backend/.venv/
venv/
.venv/

# Cache Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Base de données locale
backend/db.sqlite3

# Fichiers de log (générés par le système de logging ISO 27001)
backend/logs/

# Médias uploadés (fichiers RCT, FRO, FRP)
backend/media/

# Migrations (garder les fichiers de migration mais ignorer le cache)
# backend/*/migrations/*.py  ← NE PAS ignorer, les migrations sont importantes

# Variables d'environnement
backend/.env
backend/.env.local
backend/.env.production
.env
.env.*

# Django
*.log
local_settings.py

# Collecte des fichiers statiques
backend/staticfiles/
backend/static_collected/

